[node name="DialogText20" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=55112740]
script = ExtResource("20_swg3t")
text = "[color=232E40][b]Hey Thalia, yes. I received a divine vision. Something is stirring within the mountain. We need to investigate now before it gets worse."
npc_info = ExtResource("53_uft82")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText21" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=647893326]

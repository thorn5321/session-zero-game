[node name="DialogText16" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1627274415]
script = ExtResource("20_swg3t")
text = "[color=brown][b]Trust me, when it hatches it will all be worth it. Thanks for the help Azzy."
npc_info = ExtResource("21_afqb5")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText17" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1648380679]

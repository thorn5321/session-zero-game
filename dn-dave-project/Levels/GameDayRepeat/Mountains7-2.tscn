[node name="DialogText68" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1264448109]
script = ExtResource("20_swg3t")
text = "[color=232E40][b]Is everyone okay?"
npc_info = ExtResource("53_uft82")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText69" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=618508544]
script = ExtResource("20_swg3t")
text = "[color=9173A8][b]Yes! Are you?"
npc_info = ExtResource("49_prkqr")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText70" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=11852852]
script = ExtResource("20_swg3t")
text = "[color=232E40][b]Im fine, thank you. You saved me!"
npc_info = ExtResource("53_uft82")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText71" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=951371821]
script = ExtResource("20_swg3t")
text = "[color=62813E][b]Azalea what was that spell?"
npc_info = ExtResource("51_spotq")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText72" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=651383450]
script = ExtResource("20_swg3t")
text = "[color=brown][b]It was amazing!"
npc_info = ExtResource("21_afqb5")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText73" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=597802701]
script = ExtResource("20_swg3t")
text = "[color=9173A8][b]It was a spell I learned from Quill. It makes people afraid of you."
npc_info = ExtResource("49_prkqr")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText74" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=767755088]
script = ExtResource("20_swg3t")
text = "[color=AE7821][b]Well thats certainly useful."
npc_info = ExtResource("52_jhwxq")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText75" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=748126800]
script = ExtResource("20_swg3t")
text = "[color=232E40][b]Great work everyone."
npc_info = ExtResource("53_uft82")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText76" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=496846051]
script = ExtResource("20_swg3t")
text = "They all begin to celebrate."
npc_info = ExtResource("42_svdj0")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText77" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=2019452463]
script = ExtResource("20_swg3t")
text = "[color=brown][b]We would have been toast without this bridge."
npc_info = ExtResource("21_afqb5")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText78" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1814028294]
script = ExtResource("20_swg3t")
text = "[color=purple][b]I thought the bridge was broken."
npc_info = ExtResource("50_45dja")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText79" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1139570794]
script = ExtResource("20_swg3t")
text = "You explained that you repaired it."
npc_info = ExtResource("42_svdj0")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText80" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=878379796]
script = ExtResource("20_swg3t")
text = "[color=62813E][b]Wow great work!"
npc_info = ExtResource("51_spotq")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText81" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=2066575764]
script = ExtResource("20_swg3t")
text = "[color=AE7821][b]Yeah thanks!"
npc_info = ExtResource("52_jhwxq")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText82" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=605785396]
script = ExtResource("20_swg3t")
text = "[color=purple][b]I could never build a bridge!"
npc_info = ExtResource("50_45dja")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText83" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=927402617]

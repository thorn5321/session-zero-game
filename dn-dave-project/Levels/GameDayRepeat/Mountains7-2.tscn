[node name="DialogText25" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=606603026]
script = ExtResource("20_swg3t")
text = "[color=purple][b]Do NOT mess with that raven dude. I tried to borrow a tome and he nearly electrocuted me. I had to run all the way around to get here."

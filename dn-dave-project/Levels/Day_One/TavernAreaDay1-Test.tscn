[node name="CutsceneActionCamera" type="Node2D" parent="AreaTrigger/DialogInteraction/DialogCutscene1" unique_id=1519693961]
position = Vector2(-1183, -42)
script = ExtResource("13_oinye")
metadata/_custom_type_script = "uid://cuxyl3m86eubv"

[node name="DialogText" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1256731367]
script = ExtResource("14_st1oj")
text = "[color=purple]Now, now, my good man, surely we can settle this like reasonable folk."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1852398334]
script = ExtResource("14_st1oj")
text = "[color=9B3933]Reasonable? You ordered twelve Firebrand Fizzes, four Dragon’s Breath doubles..."
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText6" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=303453933]
script = ExtResource("14_st1oj")
text = "[color=9B3933]and somethin’ you called a “The Barrel” that I had to invent on the spot!"
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText7" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1793513128]
script = ExtResource("14_st1oj")
text = "[color=purple]It was a creative collaboration. Plus surely you wouldn’t charge a defender of the realm?"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText8" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=735345755]
script = ExtResource("14_st1oj")
text = "[color=purple]Think of it as… an investment."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText9" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=263001629]
script = ExtResource("14_st1oj")
text = "[color=9B3933]Investment? You ran up a tab big enough to buy a warhorse!"
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText10" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=259775609]
script = ExtResource("14_st1oj")
text = "[color=purple]A modest horse"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText11" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1638786637]
script = ExtResource("14_st1oj")
text = "[color=9B3933]A trained horse"
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText12" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1419251578]
script = ExtResource("14_st1oj")
text = "[color=purple]The world is safer because of me!"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText13" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=2105893417]
script = ExtResource("14_st1oj")
text = "[color=9B3933]My cellar is emptier because of you."
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText14" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=403266044]
script = ExtResource("14_st1oj")
text = "[color=purple]You would dare demand coin from a hero?"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText15" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1209507676]
script = ExtResource("14_st1oj")
text = "[color=9B3933]I would dare demand coin from anyone with a mouth and a liver."
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText16" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=763746932]
script = ExtResource("14_st1oj")
text = "[color=purple]Very well! If this is how this town treats its saviors-"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText17" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1581494869]
script = ExtResource("14_st1oj")
text = "[color=9B3933]You have been here less than a day!"
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText18" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=511220766]
script = ExtResource("14_st1oj")
text = "[color=purple]Then I shall take my business elsewhere!"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene2" type="Node" parent="AreaTrigger/DialogInteraction" unique_id=1780097009]
script = ExtResource("9_c3xks")
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"


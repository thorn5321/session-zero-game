[node name="NPC_Rogue" parent="." unique_id=764284748 instance=ExtResource("4_fbbw1")]
position = Vector2(-1097.0184, -62.384045)
scale = Vector2(0.8, 0.8)
collision_layer = 0
npc_resource = ExtResource("10_jubpe")

[node name="DialogInteraction" parent="NPC_Rogue" unique_id=937061671 instance=ExtResource("8_cytji")]
process_mode = 3
task_branch_name = "DialogText16"

[node name="DialogText" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=607618318]
script = ExtResource("14_st1oj")
text = "[color=purple]Ah! hello, um, whoever you were."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=2131408264]
script = ExtResource("14_st1oj")
text = "[color=purple]Hypothetically speaking, if someone were to slip inside, retrieve a small but symbolically important object, say, the ledger-"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=1487858598]
script = ExtResource("14_st1oj")
text = "[color=purple]and renegotiate from a position of strength…"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=312948405]
script = ExtResource("14_st1oj")
text = "[color=purple]That would be considered proactive conflict resolution, yes?"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=1000674565]
script = ExtResource("14_st1oj")
text = "..."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText6" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=833242857]
script = ExtResource("14_st1oj")
text = "[color=purple]Listen. The drinks were an accident."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText7" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=1154188740]
script = ExtResource("14_st1oj")
text = "[color=purple]I may have thought I ordered one round. The barkeep may have misunderstood. Twelve times."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText8" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=227680911]
script = ExtResource("14_st1oj")
text = "[color=purple]Besides, we are heroes. We will undoubtedly save this town at some point. Slay a beast or something."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText9" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=1253203274]
script = ExtResource("14_st1oj")
text = "[color=purple]In the grand tapestry of fate, what is a tavern tab?"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText10" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=443043140]
script = ExtResource("14_st1oj")
text = "[color=purple]Surely the barkeep will consider it a fair trade when we avert inevitable doom."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText11" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=827512109]
script = ExtResource("14_st1oj")
text = "[color=purple]Right?"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogRollCheck" type="Node" parent="NPC_Rogue/DialogInteraction" unique_id=394399077]
script = ExtResource("18_ktuy7")
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://c2ciu18v37j1l"

[node name="DialogBranch" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck" unique_id=1597930082]
script = ExtResource("19_g86m3")
text = "Charisma success"
npc_info = ExtResource("20_7kbca")
metadata/_custom_type_script = "uid://b6r741n1n8fx"

[node name="DialogText12" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=71282058]
script = ExtResource("14_st1oj")
text = "You explain that heroes probably shouldn’t pass time in town by committing light financial crimes."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText13" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=498888441]
script = ExtResource("14_st1oj")
text = "You mention that “saving the world later” is not valid legal tender."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText14" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=1341634540]
script = ExtResource("14_st1oj")
text = "[color=purple]When you explain the situation like that, it sounds bad."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText15" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=212693577]
script = ExtResource("14_st1oj")
text = "[color=purple]Fine. Fiiiiine. You make a compelling case,"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText16" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=164826109]
script = ExtResource("14_st1oj")
text = "[color=purple]I suppose legends can… temporarily experience fiscal responsibility."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText17" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=1857315649]
script = ExtResource("14_st1oj")
text = "You escort them back inside."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch" unique_id=854065468]
script = ExtResource("9_c3xks")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionPlayer" type="Node2D" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch/DialogCutscene" unique_id=1408437430]

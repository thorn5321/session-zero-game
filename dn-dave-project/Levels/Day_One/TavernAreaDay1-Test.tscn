timing_method = 1
object_to_move = NodePath("../../../../..")
move_speed = 190.0
metadata/_custom_type_script = "uid://ddmnqtx1143f7"

[node name="DialogBranch2" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck" unique_id=1480947222]
script = ExtResource("19_g86m3")
text = "Charisma fail"
npc_info = ExtResource("20_7kbca")
metadata/_custom_type_script = "uid://b6r741n1n8fx"

[node name="DialogText18" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=2305367]
script = ExtResource("14_st1oj")
text = "You say it’s not really your problem."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText19" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1043752053]
script = ExtResource("14_st1oj")
text = "You suggest that maybe they could just grab the ledger quickly."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText20" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=305309077]
script = ExtResource("14_st1oj")
text = "You admit it would probably work."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText21" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=165184124]
script = ExtResource("14_st1oj")
text = "[color=purple]Finally. A visionary."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText22" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1602884812]
script = ExtResource("14_st1oj")
text = "[color=purple]I knew there was greatness behind that extremely normal looking face."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText23" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1720612084]
script = ExtResource("14_st1oj")
text = "[color=purple]Here’s the plan. I slip inside. Quick as a mouse. I retrieve the ledger. "
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText24" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1414548885]
script = ExtResource("14_st1oj")
text = "[color=purple]Without proof of debt, there is no debt. That’s just math."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText25" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=122186609]
script = ExtResource("14_st1oj")
text = "[color=purple]Keep watch. If you see the barkeep comin’, cough loudly."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText26" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=829819948]
script = ExtResource("14_st1oj")
text = "[color=purple]But not suspiciously loudly. A natural cough. Let me hear you cough."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText27" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=8234093]
script = ExtResource("14_st1oj")
text = "You cough"
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText28" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1443634223]
script = ExtResource("14_st1oj")
text = "[color=purple]Ah, your a natural"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText29" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1449178309]
script = ExtResource("14_st1oj")
text = "They start climbing toward the window."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText30" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=80151749]
script = ExtResource("14_st1oj")
text = "[color=purple]And remember: this is technically for the greater good."
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText31" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=522262546]
script = ExtResource("14_st1oj")
text = "They slip inside."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1670021193]
script = ExtResource("9_c3xks")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionMove2" type="Node2D" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2/DialogCutscene" unique_id=161433006 node_paths=PackedStringArray("object_to_move")]
position = Vector2(-1185, -138)
scale = Vector2(0.8, 0.8000002)
script = ExtResource("16_r67if")
timing_method = 1
object_to_move = NodePath("../../../../..")
move_speed = 400.0
metadata/_custom_type_script = "uid://ddmnqtx1143f7"

[node name="DialogText32" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1446944813]
script = ExtResource("14_st1oj")
text = "A few moment later you hear a loud thud, then shouting"
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene2" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=2037687384]
script = ExtResource("9_c3xks")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionMove3" type="Node2D" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2/DialogCutscene2" unique_id=1401938038 node_paths=PackedStringArray("object_to_move")]
position = Vector2(-909, -39.000008)
scale = Vector2(0.8, 0.8000002)
script = ExtResource("16_r67if")
timing_method = 1
object_to_move = NodePath("../../../../..")
move_speed = 400.0
metadata/_custom_type_script = "uid://ddmnqtx1143f7"

[node name="DialogText34" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1967556874]
script = ExtResource("14_st1oj")
text = "[color=purple]Tactical retreat!"
npc_info = ExtResource("10_jubpe")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene3" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=147785266]
script = ExtResource("9_c3xks")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionMove4" type="Node2D" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2/DialogCutscene3" unique_id=1667721969 node_paths=PackedStringArray("object_to_move")]
position = Vector2(-555, -36.000008)
scale = Vector2(0.8, 0.8000002)
script = ExtResource("16_r67if")
timing_method = 1
object_to_move = NodePath("../../../../..")
move_speed = 400.0
metadata/_custom_type_script = "uid://ddmnqtx1143f7"

[node name="DialogText35" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=443892388]
script = ExtResource("14_st1oj")
text = "They run off. No ledger in hand"
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText36" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=1847393599]
script = ExtResource("14_st1oj")
text = "The barkeep steps outside, shouts, then heads back inside."
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText37" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=718880383]
script = ExtResource("14_st1oj")
text = "This experience has tired you out, its best you head back to the inn to sleep"
npc_info = ExtResource("17_u33k4")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene4" type="Node" parent="NPC_Rogue/DialogInteraction/DialogRollCheck/DialogBranch2" unique_id=625726954]
script = ExtResource("9_c3xks")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"


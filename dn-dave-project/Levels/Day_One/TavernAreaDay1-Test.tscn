[node name="NPC_Bartender" parent="." unique_id=1576209929 instance=ExtResource("4_fbbw1")]
position = Vector2(-1140, -50.386883)
scale = Vector2(0.8, 0.8)
collision_layer = 0
npc_resource = ExtResource("15_d7cdd")

[node name="DialogInteraction" parent="NPC_Bartender" unique_id=1730761403 instance=ExtResource("8_cytji")]
process_mode = 3

[node name="DialogText" type="Node" parent="NPC_Bartender/DialogInteraction" unique_id=140424818]
script = ExtResource("14_st1oj")
text = "[color=9B3933]You seein’ this?"
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Bartender/DialogInteraction" unique_id=118442320]
script = ExtResource("14_st1oj")
text = "He rubs his temples."
npc_info = ExtResource("30_vaqma")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Bartender/DialogInteraction" unique_id=2076578341]
script = ExtResource("14_st1oj")
text = "[color=9B3933]They have been here four days and already I’m down three bottles and up one headache."
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Bartender/DialogInteraction" unique_id=994331043]
script = ExtResource("14_st1oj")
text = "[color=9B3933]I’ve run this tavern thirty years. I know the type. Big swords. Bigger egos. "
npc_info = ExtResource("15_d7cdd")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Bartender/DialogInteraction" unique_id=2057824182]
script = ExtResource("14_st1oj")
text = "[color=9B3933]Today it’s a tab. Tomorrow it’s a bar fight with a disguised demon. "
npc_info = ExtResource("15_d7cdd")

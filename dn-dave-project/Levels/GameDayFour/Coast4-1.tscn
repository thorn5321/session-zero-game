[node name="NPC_Raven" parent="." unique_id=1445831256 instance=ExtResource("10_x5xb4")]
position = Vector2(-96, -260)
collision_layer = 0
npc_resource = ExtResource("24_tbj2q")

[node name="DialogInteraction" parent="NPC_Raven" unique_id=239261995 instance=ExtResource("13_2tjuy")]
process_mode = 3
task_branch_name = "DialogBranch2"
game_state_flag_name = "end_day_four"
transition_node_path = NodePath("../../LevelTransitionPSG")
trigger_transition_on_branch_match = true

[node name="DialogText" type="Node" parent="NPC_Raven/DialogInteraction" unique_id=1651801660]
script = ExtResource("14_8teqa")
text = "[color=black][b]It would be dangerous for you to travel back. if you want I can teleport you back to that inn you're staying at."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Raven/DialogInteraction" unique_id=837977311]
script = ExtResource("14_8teqa")
text = "[color=black][b]Dont get used to this. I wont do this again for you. Im not that generous."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Raven/DialogInteraction" unique_id=1393007963]
script = ExtResource("14_8teqa")
text = "[color=black][b]..."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Raven/DialogInteraction" unique_id=1919472563]
script = ExtResource("14_8teqa")
text = "[color=black][b]In fact, im really not that generous. Your going to help me first."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Raven/DialogInteraction" unique_id=1097958876]
script = ExtResource("14_8teqa")
text = "[color=black][b]Step into the tower, I have potions that need sorting. Dont look so glum, you might just learn something."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogChoice" type="Node" parent="NPC_Raven/DialogInteraction" unique_id=809051432]
script = ExtResource("27_oooi2")
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://1ckgxayga81g"

[node name="Node" type="Node" parent="NPC_Raven/DialogInteraction/DialogChoice" unique_id=1526101554]
script = ExtResource("28_vk61k")
text = "Not right now."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://b6r741n1n8fx"

[node name="DialogText" type="Node" parent="NPC_Raven/DialogInteraction/DialogChoice/Node" unique_id=1047988896]
script = ExtResource("14_8teqa")
text = "[color=black][b]Hmp, suit yourself."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogBranch2" type="Node" parent="NPC_Raven/DialogInteraction/DialogChoice" unique_id=1018332508]
script = ExtResource("28_vk61k")
text = "Sure thing."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://b6r741n1n8fx"

[node name="NPC_Elf" parent="." unique_id=1398263627 instance=ExtResource("10_x5xb4")]
position = Vector2(-141, -222)
collision_layer = 0
npc_resource = ExtResource("22_oooi2")

[node name="DialogInteraction" parent="NPC_Elf" unique_id=877228168 instance=ExtResource("13_2tjuy")]
process_mode = 3

[node name="DialogText2" type="Node" parent="NPC_Elf/DialogInteraction" unique_id=2015102903]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Im glad you didn't get eaten alive. I'm surprised you got as far into the swamp as you did."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="AreaTrigger3" parent="." unique_id=1948943234 instance=ExtResource("18_882jr")]

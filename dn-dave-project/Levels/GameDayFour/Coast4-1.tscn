[node name="DialogText" type="Node" parent="AreaTrigger2/DialogInteraction2" unique_id=1769421582]
script = ExtResource("14_8teqa")
text = "You hear two sets of voices"
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="AreaTrigger2/DialogInteraction2" unique_id=1420086399]
script = ExtResource("14_8teqa")
text = "Everything is hazy"
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="AreaTrigger2/DialogInteraction2" unique_id=1427141931]
script = ExtResource("14_8teqa")
text = "[color=black][b]Careful. They might have some open wounds"
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="AreaTrigger2/DialogInteraction2" unique_id=77297295]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Alright, I'll try. Im not the one built for this stuff. Where is Ras when you need him."
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="AreaTrigger2/DialogInteraction2" unique_id=2015915409]
script = ExtResource("14_8teqa")
text = "You feel yourself be lifted"
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText6" type="Node" parent="AreaTrigger2/DialogInteraction2" unique_id=1197511935]
script = ExtResource("14_8teqa")
text = "..."
npc_info = ExtResource("22_arvov")

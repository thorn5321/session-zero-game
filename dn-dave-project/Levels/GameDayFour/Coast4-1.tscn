position = Vector2(-201.17215, 774.0671)
scale = Vector2(2.3566363, 2.1359065)

[node name="DialogCutscene" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=945487683]
script = ExtResource("19_arvov")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionAnimation2" type="Node2D" parent="AreaTrigger3/DialogInteraction2/DialogCutscene" unique_id=427618712 node_paths=PackedStringArray("animation_player")]
script = ExtResource("21_ibbtq")
animation_player = NodePath("../../../../FadeTransition/Control/AnimationPlayer")
animation_name = "fade_in"
metadata/_custom_type_script = "uid://wqyqv1487hhq"

[node name="DialogText7" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1586461933]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Oh good. You’re awake."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText8" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1621009636]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]You really shouldn't have been in the swamp! You could have died, you know."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText9" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1122994875]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]This is why we need to be more proactive about dealing with things like this…"
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText10" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=430679959]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]The swamp was thick with undead. I could tell thanks to my patron"
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText11" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1156264683]
script = ExtResource("14_8teqa")
text = "[color=black][b]Reckless."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText12" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1847650029]
script = ExtResource("14_8teqa")
text = "[color=black][b]The swamp is not for amateurs."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText13" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=553534364]
script = ExtResource("14_8teqa")
text = "He hands you a cup of tea."
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText14" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=173137630]
script = ExtResource("14_8teqa")
text = "[color=black][b]Drink. It will settle your mind and cure any diseases you may or may not have picked up."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText15" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1017011832]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]He found us before the horde regrouped."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText16" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1149805483]
script = ExtResource("14_8teqa")
text = "[color=black][b]I found you because someone insisted on dramatic spellcasting. Seriously who shouts like that when casting spells"
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText17" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=941996948]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]It was efficient."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText18" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1429082054]
script = ExtResource("14_8teqa")
text = "[color=black][b]It was loud. Did you give all of your spells a special name?"
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText19" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=171330300]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I did, they are very cool in my opinion."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText20" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=412735854]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I am glad you are alright."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText21" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=257028583]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I should have accompanied you sooner. I sensed something wrong but assumed you would turn back."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText22" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=114187361]
script = ExtResource("14_8teqa")
text = "[color=black][b]Survival requires judgment. Which you clearly lack."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText23" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1794174701]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Don't be so harsh, I'm sure they didn't plan to nearly be eaten."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText24" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1707233384]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I was able to find you and defeat the zombies thanks to my patron. He is related to the undead."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText25" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1965046675]
script = ExtResource("14_8teqa")
text = "[color=black][b]Interesting, do you talk often with your patron?"
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText26" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=935794041]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Yes, he tells me things but they are often cryptic. Half the time I dont know what he is trying to tell me."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText27" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=2034016301]
script = ExtResource("14_8teqa")
text = "[color=black][b]I may have a book on the matter. Why dont we talk after this one is better. I'll see if I can find the book."
npc_info = ExtResource("24_tbj2q")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText28" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=146801422]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Really? I'd love that, thank you!"
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText29" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=634812291]
script = ExtResource("14_8teqa")
text = "She turns towards you."
npc_info = ExtResource("22_arvov")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText30" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=511062403]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I wish I could do more for you."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText31" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1080957778]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]…"
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText32" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=2123659921]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I'll become stronger so I can better control my abilities. So less people end up like you."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText33" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=845377704]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]…"
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText34" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=533015130]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]Oh I didn't mean it like that! Like you as in injured and nearly dead. Not as in exceedingly average."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText35" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1977506423]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]…"
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText36" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1816326355]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I'm sorry."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText37" type="Node" parent="AreaTrigger3/DialogInteraction2" unique_id=1365012227]
script = ExtResource("14_8teqa")
text = "[color=9173A8][b]I promise I'll make sure your town is in good hands."
npc_info = ExtResource("22_oooi2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"


[node name="DialogText" type="Node" parent="NPC_Patrol2/NpcBehaviorPatrol/DialogInteraction" unique_id=1973495004]
script = ExtResource("16_68p55")
text = "[color=232E40][b]Greetings citizen. Are you lost?"
npc_info = ExtResource("21_002c2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Patrol2/NpcBehaviorPatrol/DialogInteraction" unique_id=635016514]
script = ExtResource("16_68p55")
text = "[color=232E40][b]Im Ras, me and my party are investigating this mountain area. Dont go over there okay? Its dangerous and you could hurt yourself."
npc_info = ExtResource("21_002c2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Patrol2/NpcBehaviorPatrol/DialogInteraction" unique_id=855939166]
script = ExtResource("16_68p55")
text = "[color=232E40][b]Dont worry citizen, we will take care of any danger. So you can rest easy."
npc_info = ExtResource("21_002c2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Patrol2/NpcBehaviorPatrol/DialogInteraction" unique_id=889229207]
script = ExtResource("16_68p55")
text = "[color=232E40][b]The bridge? It was broken when we arrived. Unfortunately we don't know how to repair it."
npc_info = ExtResource("21_002c2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Patrol2/NpcBehaviorPatrol/DialogInteraction" unique_id=429050812]
script = ExtResource("16_68p55")
text = "[color=232E40][b]I would love to help, but my hands are full with this investigation. Forgive me citizen, heros can only do so much at once."
npc_info = ExtResource("21_002c2")
metadata/_custom_type_script = "uid://bbccl13o27g0t"


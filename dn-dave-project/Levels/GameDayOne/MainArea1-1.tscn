[node name="NPC_Innkeeper" parent="." unique_id=331189146 instance=ExtResource("7_6dq62")]
position = Vector2(-1430, 220)
collision_layer = 0
npc_resource = ExtResource("14_jqu3d")

[node name="DialogInteraction" parent="NPC_Innkeeper" unique_id=121067694 instance=ExtResource("10_qcfsn")]
process_mode = 3

[node name="DialogText" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1497457632]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]Howdy! I hope you slept well last night!"
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1067063165]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]I hope you know that's the only night I can give you for free."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1159421520]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]Im sorry, but I got a business to run. Gotta keep the lights on and such."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1240554002]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]If you’re lookin for some more coin. There are plenty of people who need help around the town."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText6" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=293542878]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]In fact, I heard that that group of adventurers have had some business in the town."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText7" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1137124846]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]Apparently they need help with some things."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText8" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=933571679]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]Folk like them are always carryin around some extra money."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText9" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1160116705]
script = ExtResource("11_s0r6j")
text = "[color=68A72B][b]If your are lookin to get started right away, you should head on over to the tavern."
npc_info = ExtResource("14_jqu3d")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText10" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=585688282]
script = ExtResource("11_s0r6j")

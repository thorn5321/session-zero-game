[node name="DialogText" type="Node" parent="NPC_Dwarf_Patrol/DialogInteraction" unique_id=1140496402]
script = ExtResource("11_s0r6j")
text = "[b] Why are you so tall? [/b]"
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Dwarf_Patrol/DialogInteraction" unique_id=2043831259]
script = ExtResource("11_s0r6j")
text = "
[wave] Um, Im not really that tall... [/wave]"
npc_info = SubResource("Resource_3321n")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Dwarf_Patrol/DialogInteraction" unique_id=2057172205]
script = ExtResource("11_s0r6j")
text = "Well from down here you sure are!"
metadata/_custom_type_script = "uid://bbccl13o27g0t"


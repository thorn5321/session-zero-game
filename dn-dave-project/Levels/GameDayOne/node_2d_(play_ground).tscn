[node name="NPC_Innkeeper" parent="." unique_id=331189146 instance=ExtResource("7_a3rc0")]
position = Vector2(-1430, 220)
collision_layer = 0
npc_resource = ExtResource("14_d6njs")

[node name="DialogInteraction" parent="NPC_Innkeeper" unique_id=121067694 instance=ExtResource("10_gx1aq")]
process_mode = 3

[node name="DialogText" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1497457632]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]Howdy! I hope you slept well last night!"
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1067063165]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]I hope you know that's the only night I can give you for free."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1159421520]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]Im sorry, but I got a business to run. Gotta keep the lights on and such."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1240554002]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]If you’re lookin for some more coin. There are plenty of people who need help around the town."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText6" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=293542878]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]In fact, I heard that that group of adventurers have had some business in the town."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText7" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1137124846]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]Apparently they need help with some things."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText8" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=933571679]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]Folk like them are always carryin around some extra money."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText9" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=1160116705]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]If your are lookin to get started right away, you should head on over to the tavern."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText10" type="Node" parent="NPC_Innkeeper/DialogInteraction" unique_id=585688282]
script = ExtResource("11_0m7im")
text = "[color=68A72B][b]I heard there was some commotion goin on there. Maybe you could go give it a look see."
npc_info = ExtResource("14_d6njs")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="PlayerSpawn" parent="." unique_id=497884489 instance=ExtResource("15_o2nk3")]
position = Vector2(-1215, -44)

[node name="NPC_Wander_Bard" parent="." unique_id=540330476 instance=ExtResource("7_a3rc0")]
position = Vector2(-1145, -46.999985)
npc_resource = ExtResource("16_0xibh")

[node name="NpcBehaviorWander" parent="NPC_Wander_Bard" unique_id=1970456908 instance=ExtResource("13_8nbac")]

[node name="DialogInteraction" parent="NPC_Wander_Bard/NpcBehaviorWander" unique_id=913174715 instance=ExtResource("10_gx1aq")]
process_mode = 3

[node name="DialogText" type="Node" parent="NPC_Wander_Bard/NpcBehaviorWander/DialogInteraction" unique_id=1071562639]
script = ExtResource("11_0m7im")
text = "[wave][color=62813E][b]Oh I’ve walked the road from dusk till dawn, with boots near gone and coin long gone.."
npc_info = ExtResource("16_0xibh")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Wander_Bard/NpcBehaviorWander/DialogInteraction" unique_id=1031674586]
script = ExtResource("11_0m7im")
text = "[wave][color=62813E][b]But a song in hand and a tale to spin,
Will buy you bread and a place within."
npc_info = ExtResource("16_0xibh")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Wander_Bard/NpcBehaviorWander/DialogInteraction" unique_id=877084626]
script = ExtResource("11_0m7im")
text = "[b]..."
npc_info = ExtResource("17_ldbqw")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Wander_Bard/NpcBehaviorWander/DialogInteraction" unique_id=575104367]
script = ExtResource("11_0m7im")
text = "[color=62813E][b]Oh, sorry I didnt see you there. I was practicing my singing."
npc_info = ExtResource("16_0xibh")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText5" type="Node" parent="NPC_Wander_Bard/NpcBehaviorWander/DialogInteraction" unique_id=1872919235]
script = ExtResource("11_0m7im")
text = "[color=62813E][b]You're looking for the tavern? Just head up north, cant miss it."
npc_info = ExtResource("16_0xibh")
metadata/_custom_type_script = "uid://bbccl13o27g0t"


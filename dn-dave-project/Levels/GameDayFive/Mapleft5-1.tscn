[node name="DialogText" type="Node" parent="NPC_Wander/DialogInteraction" unique_id=1036525718]
script = ExtResource("26_t8rhd")
text = "[color=7C4823][b]My son made this produce stand for me. He left a few months ago."
npc_info = ExtResource("30_otu8l")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText2" type="Node" parent="NPC_Wander/DialogInteraction" unique_id=433059788]
script = ExtResource("26_t8rhd")
text = "[color=7C4823][b]He wanted to become an adventurer. I wanted to let him follow his dreams. But I worry about him all the time."
npc_info = ExtResource("30_otu8l")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText3" type="Node" parent="NPC_Wander/DialogInteraction" unique_id=2108786911]
script = ExtResource("26_t8rhd")
text = "[color=7C4823][b]So sometimes I come and inspect the stand he made. He did such a great job making it. I was so proud of him, still am!"
npc_info = ExtResource("30_otu8l")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText4" type="Node" parent="NPC_Wander/DialogInteraction" unique_id=1772603202]
script = ExtResource("26_t8rhd")
text = "[color=7C4823][b]I just hope this stand isnt the only thing I'll have to remember him by one day. Adventuring is a dangerous career."
npc_info = ExtResource("30_otu8l")
metadata/_custom_type_script = "uid://bbccl13o27g0t"


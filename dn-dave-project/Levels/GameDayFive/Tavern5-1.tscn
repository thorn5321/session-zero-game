[node name="DialogText45" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=319563761]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Mind if I join? Friendly competition?"
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText46" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=2144983558]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Why not? I’m on a streak."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText47" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1439945491]
script = ExtResource("27_v4g04")
text = "Cards are played."
npc_info = ExtResource("37_lbvyb")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText48" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1395546555]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Say…the way you’re dealing seems…weird. Is this a trick?"
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText49" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=570325125]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Trick? Me? No no no."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText50" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1700459546]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]The way your hands are moving…"
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText51" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1056785455]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Im double jointed, see?"
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText52" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1691464235]
script = ExtResource("27_v4g04")
text = "The gambler lifts his hands and a card slips out of his sleeve. It lands face up on the table."
npc_info = ExtResource("37_lbvyb")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText53" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1572592366]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Let me see the deck"
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText54" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=2128371601]
script = ExtResource("27_v4g04")
text = "They grab the deck"
npc_info = ExtResource("37_lbvyb")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText55" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=446701949]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]You were about to deal yourself 8 aces, where did you even get that many? What kind of deck is this?"
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText56" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=659791536]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Overachievement is not a crime."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText57" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=892761338]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]You are the worst cheat I have ever seen and I was raised by pirates."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText58" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1181098825]
script = ExtResource("27_v4g04")
text = "[color=6E3225]I guarantee I'm better than those pirates. Little secret: I'm famous."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText59" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1111805367]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Never heard of you and I quite literally write songs about famous people."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText60" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1191636010]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Perfect, I've always felt like I could use a theme song."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText61" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1646574789]
script = ExtResource("27_v4g04")
text = "They continue to banter as the day drags on. You should head to bed."
npc_info = ExtResource("37_lbvyb")
metadata/_custom_type_script = "uid://bbccl13o27g0t"


[node name="DialogText9" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=401804545]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Hey. You. You look like someone with untapped potential."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=63882773]
script = ExtResource("30_d0ujj")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionPlayer" type="Node2D" parent="AreaTrigger3/DialogInteraction/DialogCutscene" unique_id=81761578]
position = Vector2(36, -82)
script = ExtResource("41_la0o1")
finish_direction = "right"
timing_method = 1
metadata/_custom_type_script = "uid://cmchrj4pfiwmh"

[node name="DialogText10" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1952682227]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Tell me bud, can you keep a secret?"
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText11" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1025191430]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Listen, you know, they say I’m the greatest thief to ever live."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText12" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1197455891]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Oh yes there are many stories about my exploits."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText13" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=926977718]
script = ExtResource("27_v4g04")
text = "[color=6E3225]I've stolen from nobles, priest, kings."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText14" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=931292485]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Nothing can stop me!"
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText15" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1026553086]
script = ExtResource("27_v4g04")
text = "[color=6E3225]People in this world let the laws hold too much sway over them."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText16" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=850934813]
script = ExtResource("27_v4g04")
text = "[color=6E3225]They forget their free will. Im an expert at exercising free will."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText17" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=752528215]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Its why ive become so famous!"
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText18" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1931030730]
script = ExtResource("27_v4g04")
text = "You ask why no one’s heard of him."
npc_info = ExtResource("39_d56aw")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText19" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1365638773]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Obviously because I’m hiding my identity."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText20" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1335934367]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Hard to build a reputation when I have to be in hiding like this. It's tragic really."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText21" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=224660787]
script = ExtResource("27_v4g04")
text = "[color=6E3225]If the guards spotted you with me they may throw you in jail. Thinking you're my sidekick."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText22" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1042011929]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Ah but down worry. Ill make sure you’re not spotted or nothing."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText23" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1765392164]
script = ExtResource("27_v4g04")
text = "[color=6E3225]But if you’re interested in helping your new friend out..."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText24" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1947188787]
script = ExtResource("27_v4g04")
text = "[color=6E3225]You see the one with the instruments over there?"
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene2" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1758829108]
script = ExtResource("30_d0ujj")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionCamera" type="Node2D" parent="AreaTrigger3/DialogInteraction/DialogCutscene2" unique_id=389542778]
position = Vector2(-189, -105)
script = ExtResource("37_lr7dn")
move_speed = 23.0
metadata/_custom_type_script = "uid://cuxyl3m86eubv"

[node name="DialogText25" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=2093501550]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Yeah him."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene3" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1003999088]
script = ExtResource("30_d0ujj")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionCamera" type="Node2D" parent="AreaTrigger3/DialogInteraction/DialogCutscene3" unique_id=924091242]
position = Vector2(36, -104)
script = ExtResource("37_lr7dn")
metadata/_custom_type_script = "uid://cuxyl3m86eubv"

[node name="DialogText26" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=722129075]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Here’s the play. I’ll teach you the game proper. And maybe… a subtle trick or two."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText27" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=377760338]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Nothing dramatic. Just enough tilt of the wrist. A little misdirection."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText28" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=675319755]
script = ExtResource("27_v4g04")
text = "[color=6E3225]You go up there. Play a few rounds. Let him win."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText29" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=100885885]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Then I slide in. He’s confident. Relaxed. Guard down."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText30" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1638152966]
script = ExtResource("27_v4g04")
text = "[color=6E3225]And I relieve him of some unnecessary coin."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText31" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=443114317]
script = ExtResource("27_v4g04")
text = "[color=6E3225]Alright, get going. Ill come in ina bit. We don't know each other."
npc_info = ExtResource("36_s7s31")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogCutscene4" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=387079569]
script = ExtResource("30_d0ujj")
metadata/_custom_type_script = "uid://c122tmyq2gw3i"

[node name="CutsceneActionPlayer" type="Node2D" parent="AreaTrigger3/DialogInteraction/DialogCutscene4" unique_id=356213980]
position = Vector2(-197, -132)
script = ExtResource("41_la0o1")
finish_direction = "right"
timing_method = 1
metadata/_custom_type_script = "uid://cmchrj4pfiwmh"

[node name="CutsceneActionCamera" type="Node2D" parent="AreaTrigger3/DialogInteraction/DialogCutscene4" unique_id=965244187]
position = Vector2(-188, -106)
script = ExtResource("37_lr7dn")
metadata/_custom_type_script = "uid://cuxyl3m86eubv"

[node name="DialogText34" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=818079893]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Oh. It’s you."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText33" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1641634606]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]If this is about the Rogue, I’ve already lectured her twice today."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText35" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1694227442]
script = ExtResource("27_v4g04")
text = "You mention cards."
npc_info = ExtResource("39_d56aw")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText36" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=979631067]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Cards? I suppose I could use distraction."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText37" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1435937214]
script = ExtResource("27_v4g04")
text = "You sit down and begin to play"
npc_info = ExtResource("37_lbvyb")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText38" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1049063874]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Adventuring sounds glorious when sung about."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText39" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1711230104]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]It is mostly mud, and walking. There is a ton of down time"
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText40" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=505228210]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Ras has been going on and on about this bad feeling he got."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText41" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=76928784]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Im hoping for a bit of action soon, but I don't mind the peace of this town."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText42" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=591517805]
script = ExtResource("27_v4g04")
text = "[color=62813E][b]Cards do help quiet the mind."
npc_info = ExtResource("38_r2r0e")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText43" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1777858548]
script = ExtResource("27_v4g04")
text = "You play cards and let the bard win"
npc_info = ExtResource("37_lbvyb")
metadata/_custom_type_script = "uid://bbccl13o27g0t"

[node name="DialogText44" type="Node" parent="AreaTrigger3/DialogInteraction" unique_id=1844689314]
